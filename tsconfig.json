{
  "files": [],
  "references": [
    {
      "path": "./tsconfig.app.json"
    },
    {
      "path": "./tsconfig.node.json"
    }
  ],
  "compilerOptions": {
    "types": [
      "vite/client"
    ],
    "skipLibCheck": true, // ① 忽略库类型检查
    "allowSyntheticDefaultImports": true, // ② 允许合成默认导入
    "module": "ESNext",
    "moduleResolution": "bundler", // ③ 使用 bundler 模式（Vite 默认）
    "baseUrl": ".",
    "paths": {
      "@/*": [
        "src/*"
      ]
    }
  }
}